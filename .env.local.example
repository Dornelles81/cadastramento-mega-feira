# Database Configuration
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Autenticação do painel (NextAuth + contas individuais em EventAdmin).
# NEXTAUTH_SECRET é OBRIGATÓRIA: não há fallback, a aplicação falha sem ela.
# NÃO existe senha compartilhada — as antigas ADMIN_PASSWORD e SECRET_KEY
# foram removidas do código e do ambiente; não as reintroduza.
NEXTAUTH_SECRET="<segredo-aleatorio-forte>"
NEXTAUTH_URL="http://localhost:3000"

# Chave de criptografia dos dados biométricos e documentos (AES-256-GCM).
# Mínimo de 32 caracteres.
MASTER_KEY="<chave-de-32-caracteres-ou-mais>"

# Other configurations
NEXT_PUBLIC_APP_URL="http://localhost:3000"
